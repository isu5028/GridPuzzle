      m_Items: []
  - m_Id: 18496331232960512
    m_Localized: Do you want to move?
    m_Metadata:
      m_Items: []
  - m_Id: 30899128402305024
    m_Localized: BLOCKED
    m_Metadata:
      m_Items: []
  - m_Id: 30989257947078656
    m_Localized: RESET ENEMY POSITIONS
    m_Metadata:
      m_Items: []
  - m_Id: 35893236892033024
    m_Localized: King's Tips
    m_Metadata:
      m_Items: []
  - m_Id: 35893318685155328
    m_Localized: Psst... you can get from 3-4-1 to 2-4-1.
    m_Metadata:
      m_Items: []
  - m_Id: 35893392446185472
    m_Localized: 'My crew follows the rules to a T.

      I trained ''em so when
      they can''t decide

      which way to go, they gotta prioritize

      their
      moves like this:


      1.Left 2.Right 3.Up 4.Down'
    m_Metadata:
      m_Items: []
  - m_Id: 35893516526280704
    m_Localized: "The moment you step onto the stairs,\nmy crew freezes up.\n\nAnd
      right after you move off 'em,\nthe ones standin' right there \u2014\nthey ain't
      movin' 'til you do."
    m_Metadata:
      m_Items: []
  - m_Id: 35893533836173312
    m_Localized: "3-1-3\r\n\u2193\r\n3-1-2\r\n2-1-3\r\n\u2193\r\n2-0-3\r\n\u2193\r\n2-0-2\r\n\u2193\r\n2-0-1\r\n\u2193"
    m_Metadata:
      m_Items: []
  - m_Id: 35893534977024000
    m_Localized: 'Just for the record,

      I absolutely love Mekabu seaweed.'
    m_Metadata:
      m_Items: []
